{
  "manifest_version": 3,
  "name": "Crunchyroll PiP Helper",
  "description": "Adds a Picture-in-Picture button with Option+P on macOS and Alt+P on Windows/Linux.",
  "version": "1.0.5",
  "homepage_url": "https://github.com/mlemors/crunchyroll-pip-extension",
  "permissions": ["scripting"],
  "host_permissions": [
    "https://www.crunchyroll.com/*",
    "https://crunchyroll.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.crunchyroll.com/*",
        "https://crunchyroll.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Crunchyroll PiP",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
